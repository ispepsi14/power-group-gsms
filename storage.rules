rules_version = '2';

// ===================================================================
// POWER GROUP GSMS — Cloud Storage Security Rules
//
// *** ร่าง — ต้องเทียบกับกฎใน Console ก่อน publish ***
//
// ไฟล์นี้เขียนจากโค้ดของแอพ (public/index.html v4.6.6) แล้วเทียบกับกฎตัวจริงใน Console
// ที่เจ้าของคัดมาให้เมื่อ 24 ต.ค. 2569 (สำเนาตรงตัวอักษรสำหรับย้อนกลับ/เทสต์ emulator:
// docs/specs/storage-rules-console-2026-10-24.txt)
//
// ผลเทียบกับ Console (24 ต.ค. 2569):
//   [x] 1. Console มี path เดียวคือ jobPhotos/{jobId}/{photoId} — ไม่มี path อื่นที่ต้องย้ายมา
//   [x] 2. jobPhotos ใน Console ใช้แค่ "request.auth != null" (read/write/delete)
//          = ลูกค้า anonymous จากหน้าแชท/หน้าตามรถ อัปโหลด/ลบรูปรถได้ — ไฟล์นี้บีบให้เหลือ
//          เฉพาะบัญชีที่มี users/{uid} (พนักงาน/แอดมิน)
//   [x] 3. Console จำกัด < 5 MB และ image/* — ไฟล์นี้ใช้ตัวเลขเดียวกัน (ไม่หลวมกว่า)
//   [x] 4. catch-all ใน Console เป็น if false อยู่แล้ว — ไฟล์นี้คงไว้เหมือนเดิม
//   [!] ใหม่: jobThumbs/ ไม่มีใน Console (ตอนนี้การอัปโหลดรูปย่อถูกปฏิเสธ แอพถอยไปเก็บ
//          base64 ในตัวงาน) หลัง publish รูปย่อจะเริ่มขึ้น Storage แทน base64
//
// ก่อนกด Publish:
//   [ ] 5. ตอน Publish ครั้งแรก Console จะถามให้อนุญาต Storage อ่าน Firestore
//          (สำหรับ firestore.exists) ให้กด Grant/อนุญาต ไม่งั้นทุกการอัปโหลดจะถูกปฏิเสธ
//   [ ] 6. ถ้าพัง ให้วางกฎจาก docs/specs/storage-rules-console-2026-10-24.txt กลับแล้ว Publish
//          (ตรวจก่อนว่ากฎใน Console ยังตรงกับสำเนานั้น ไม่มีใครแก้หลัง 24 ต.ค.)
//   [x] 7. รันกับ Storage emulator แล้ว (anonymous / พนักงาน / แอดมิน / bootstrap)
//          bash tests/rules-emu/run-all.sh storage.rules firestore.rules (26 ต.ค. 2569)
//          ผล: 36/36 ข้อผ่าน (storage 45/45 · firestore 35/35 assertion) รวม CONTROL M4-2g
//
// เปลี่ยนในรอบ bugfix-round2 (4.6.9):
//   - jobThumbs: contentType ต้องเป็น image/jpeg เท่านั้น (S1)
//   - jobPrints ลบ: แอดมินเท่านั้น (bootstrap หรือ users/{uid}.role == 'admin') (M3)
//   - jobPrints เขียน: กันไฟล์ printedAtMs เก่ากว่าทับไฟล์ใหม่ + ห้าม printedAtMs ล้ำเกิน 10 นาที (M4)
//     request ที่ไม่มี printedAtMs (เครื่อง 4.6.8) ผ่านเหมือนเดิม — ข้อจำกัด: เครื่องเก่ายังทับ
//     ไฟล์ใหม่ได้จนกว่าจะอัปเดตเป็น 4.6.9
//
// การเรียก getDownloadURL() / getMetadata() ผ่าน SDK "ตรวจกฎ read" ข้างล่าง (แอพเรียก
// getDownloadURL ทันทีหลังพนักงานอัปโหลด จึงผ่าน hasAccess) · สิ่งที่ไม่ตรวจกฎคือการ
// "เปิดลิงก์ที่มี token ติดมา" (ลิงก์ที่ getDownloadURL คืนให้และเก็บไว้ใน Firestore)
// → หน้า board/ หน้าแชทลูกค้า และปุ่มส่งเข้า LINE ที่ fetch จากลิงก์เดิม ยังเปิดรูปได้เหมือนเดิม
//
// วิธีใช้: Firebase Console -> Storage -> แท็บ Rules -> วางไฟล์นี้ -> Publish
// ไฟล์นี้ไม่ได้ผูกกับ firebase.json (ตั้งใจ — กัน "firebase deploy" เปล่า ๆ เขียนทับ Console)
// ===================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ---------- ตัวช่วย (ต้องตรงกับ firestore.rules) ----------
    // บัญชีแอดมินตั้งต้น เหมือน bootstrapAdmin() ใน firestore.rules
    function bootstrapAdmin() {
      return request.auth != null
        && request.auth.uid == '79YAV3SBT7ZAFfCz9rLMYyTRlPw1';
    }

    // พนักงาน/แอดมิน = มีเอกสาร users/{uid} (เหมือน hasAccess() ใน firestore.rules)
    // ลูกค้าที่ล็อกอินแบบ anonymous จากหน้าแชท/หน้าตามรถ ไม่มี users/{uid} จึงไม่ผ่าน
    function hasAccess() {
      return bootstrapAdmin()
        || (request.auth != null
            && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)));
    }

    // รูปที่แอพอัปโหลด: แอพย่อรูปเป็น JPEG ก่อนส่งเสมอ (dataUrlToBlob)
    function isPhotoUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------- รูปรถตอนรับรถ ----------
    // แอพเขียน: jobPhotos/{jobId}/{uid}.jpg  (index.html uploadJobPhoto)
    // แอพลบ:    deleteStoragePath() ตอนลบรูป/ลบงานถาวร
    match /jobPhotos/{jobId}/{f} {
      allow read: if hasAccess();
      allow create, update: if hasAccess() && isPhotoUpload();
      allow delete: if hasAccess();
    }

    // ---------- รูปย่อหน้าปก ----------
    // แอพเขียน: jobThumbs/{jobId}/{uid}.jpg  (index.html uploadJobThumb)
    match /jobThumbs/{jobId}/{f} {
      allow read: if hasAccess();
      allow create, update: if hasAccess() && isPhotoUpload()
        && request.resource.contentType == 'image/jpeg';
      allow delete: if hasAccess();
    }

    // ---------- ภาพใบรับรถ / ใบเสนอราคา สำหรับ LINE Bot (งาน line-bot-queue-command, S7) ----------
    // แอพเขียน receipt.jpg / quote-<n>.jpg · Bot อ่านผ่าน Admin SDK + signed URL (ไม่ผ่านกฎนี้)
    // มีชื่อ เบอร์ ทะเบียน ราคา → ห้าม anonymous อ่าน/เขียน · ลบได้เฉพาะแอดมิน (ตอนลบงานถาวร)
    // printedAtMs = customMetadata (สตริงตัวเลข ms) ที่แอพ 4.6.9 ส่งมา → แปลงด้วย int()
    // emulator ประเมินการทับไฟล์เป็น create (resource != null) → เงื่อนไขกันทับใส่ทั้ง create, update
    // เงื่อนไขเขียน firestore.exists ไว้ตรง ๆ (ไม่เรียก hasAccess()) ให้ guard ตรวจได้
    match /jobPrints/{jobId}/{file} {
      allow read: if request.auth != null
        && (request.auth.uid == '79YAV3SBT7ZAFfCz9rLMYyTRlPw1'
            || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)));
      allow create, update: if request.auth != null
        && (request.auth.uid == '79YAV3SBT7ZAFfCz9rLMYyTRlPw1'
            || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)))
        && file.matches('receipt[.]jpg|quote-[0-9]{1,2}[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024
        && (resource == null
            || !('printedAtMs' in resource.metadata)
            || !('printedAtMs' in request.resource.metadata)
            || int(request.resource.metadata.printedAtMs) >= int(resource.metadata.printedAtMs))
        && (!('printedAtMs' in request.resource.metadata)
            || int(request.resource.metadata.printedAtMs) <= request.time.toMillis() + 600000);
      allow delete: if request.auth != null
        && (request.auth.uid == '79YAV3SBT7ZAFfCz9rLMYyTRlPw1'
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ---------- ที่เหลือทั้งหมด: ปิด ----------
    // Storage rules เป็น OR — ถ้ามี match ไหนเปิดกว้าง กฎเข้มข้างบนก็ไร้ผล
    // path ใหม่ต้องเพิ่ม match ของตัวเองข้างบน ห้ามแก้บล็อกนี้ให้เปิด
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
