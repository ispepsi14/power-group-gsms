rules_version = '2';

// ===================================================================
// POWER GROUP GSMS — Firestore Security Rules  (v4.0.0)
//
// วิธีใช้:
//   Firebase Console -> Firestore Database -> แท็บ Rules
//   -> ลบของเดิมทั้งหมด -> วางไฟล์นี้แทน -> กด Publish
//
// กฎพวกนี้บังคับที่เซิร์ฟเวอร์ ไม่ใช่แค่ซ่อนปุ่มในแอป
// ต่อให้มีคนแก้โค้ดหน้าเว็บ ก็ยังทำเกินสิทธิ์ไม่ได้
//
// เปลี่ยนจากฉบับก่อนหน้า 4 จุด (ดูคอมเมนต์ "[แก้]" ที่จุดนั้น ๆ):
//   1. feedback/        — คอลเลกชันใหม่ทั้งหมด (หน้า ?feedback ใช้งานไม่ได้เลยถ้าไม่มี)
//   2. config/          — เดิมล็อก isAdmin() ทั้งคอลเลกชัน ทั้งที่พนักงานทั่วไปต้อง
//                         เขียน pushTokens/queueCounter/technicians ทุกวัน
//   3. chatThreads/     — เดิม allow read ครอบทั้ง get และ list ทำให้ลูกค้าคนไหนก็
//                         เปิด console แล้ว list ทั้งคอลเลกชันดูห้องแชทคันอื่นได้
//   4. presence/        — คอลเลกชันใหม่ทั้งหมด (แถบ "ใครใช้แอปอยู่ตอนนี้" v4.0.0)
//   5. boardPublic/     — คอลเลกชันใหม่ (ยังไม่มีอะไรเขียนจริง แต่โค้ดแอปอ่านอยู่แล้ว
//                         เผื่อไว้ล่วงหน้า กันต้องกลับมาแก้ rules อีกรอบทีหลัง)
// ===================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ตัวช่วย ----------

    // บัญชีผู้ดูแลตั้งต้น (ของคุณ) — ฝังไว้ตรงนี้เพื่อ 2 เหตุผล:
    //  1. ตอนเริ่มระบบยังไม่มีเอกสารใน users/ เลยสักอัน ถ้าไม่มีบรรทัดนี้
    //     จะไม่มีใครมีสิทธิ์สร้างคนแรกได้ (ไก่กับไข่)
    //  2. เป็นกันเหนียว — เผลอลบสิทธิ์ตัวเองก็ยังเข้าระบบได้เสมอ
    function bootstrapAdmin() {
      return request.auth != null
        && request.auth.uid == '79YAV3SBT7ZAFfCz9rLMYyTRlPw1';
    }

    // [multi-branch] all-branch account: UID + email hash must both match (the repo is public, so no plain email here)
    // UID is checked first: anonymous tokens have no email claim
    function allBranchUid() { return 'GqybqhanlWXyKYTVnLqe9YwPknz1'; }
    function allBranchAdmin() {
      return request.auth != null
        && request.auth.uid == allBranchUid()
        && hashing.sha256(request.auth.token.email.toUtf8()).toHexString().lower() == 'adaf5b32d99f927f6f516b9d651d412a7f8f3efe4415994c8b22f637032bbf23';
    }

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ต้องมีเอกสารใน users/{uid} ถึงจะใช้ระบบได้
    // (สร้างบัญชีใน Authentication เฉยๆ ยังเข้าไม่ได้ จนกว่า Admin จะให้สิทธิ์)
    // [multi-branch] root = Don Mueang. Every root rule goes through memberOf/adminOf('donmueang') (B-1, B-2)
    function hasAccess() { return memberOf('donmueang'); }

    function isAdmin() { return adminOf('donmueang'); }

    function bootUid() { return '79YAV3SBT7ZAFfCz9rLMYyTRlPw1'; }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Bootstrap is pinned to Don Mueang whatever its doc says (decision 7, B-7)
    // Phase 2 (P2-3): a missing branchId is no branch at all, never Don Mueang. Same change in storage.rules and the app.
    function callerBranch() {
      return bootstrapAdmin() ? 'donmueang' : profile().get('branchId', '');
    }
    // Phase 2 fix 1: an empty branch ('' = no branchId) never matches a member/admin. Only the all-branch account sees no-branch docs.
    function memberOf(b) {
      return allBranchAdmin()
        || (signedIn() && b != '' && (bootstrapAdmin() ? b == 'donmueang' : (hasUserDoc() && callerBranch() == b)));
    }
    function adminOf(b) {
      return allBranchAdmin()
        || (b == 'donmueang' && bootstrapAdmin())
        || (signedIn() && b != '' && !bootstrapAdmin() && hasUserDoc() && callerBranch() == b && profile().role == 'admin');
    }
    function anonCustomer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validBranch(b) {
      return b is string && b != 'donmueang' && b.matches('^[a-z0-9-]{2,24}$');
    }

    // ---------- users helpers ----------
    function userBranch(d) { return d.get('branchId', ''); }
    function userKeys() { return ['name', 'email', 'role', 'branchId']; }
    function userRoleOk(d) { return d.get('role', 'staff') in ['admin', 'staff']; }
    // S-5: the all-branch account must always send branchId as a real, known value
    function allBranchUserWriteOk(userId) {
      let nb = request.resource.data.branchId;
      return allBranchAdmin()
        && nb is string
        && (nb == 'donmueang' || (validBranch(nb) && exists(/databases/$(database)/documents/branches/$(nb))))
        && (userId != bootUid() || nb == 'donmueang')
        && userRoleOk(request.resource.data)
        // Phase 2 fix 2: create = same id format as the branch-admin path (real Auth UID). Update/move keeps the existing id.
        && (request.method != 'create' || userId.matches('^[A-Za-z0-9]{20,128}$'));
    }

    // [ใหม่ 24 ต.ค. 2569 — S-NEW-1] คีย์ที่หน้าลูกค้า (?reception แชท) เขียนลง chatThreads/{jobId}
    // ได้: chatSend (summary) · chatMarkRead (unreadCustomer) · chatRequestHuman (botOff)
    function chatThreadCustomerKeys() {
      return ['lastText', 'lastAt', 'lastFrom', 'updatedAt', 'jobId', 'queueNo', 'plate',
              'province', 'carName', 'unreadAdmin', 'unreadCustomer', 'botOff'];
    }

    // ---------- ผู้ใช้และสิทธิ์ ----------
    // ทุกคนอ่านโปรไฟล์ตัวเองได้ (แอปต้องอ่านเพื่อรู้ว่าเป็น admin หรือ staff)
    // แต่สร้าง/แก้/ลบสิทธิ์ ทำได้เฉพาะ Admin
    // [multi-branch] the same default ('' = no branch) is applied on BOTH sides, so removing branchId cannot move an account (B-3, P2-3).
    // list: a plain collection get is denied; the query must carry where('branchId','==',x) (S-4). Owner backfills first.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId
        || allBranchAdmin()
        || (resource == null && adminOf(callerBranch()))
        || (resource != null && adminOf(userBranch(resource.data))));
      allow list: if allBranchAdmin() || adminOf(resource.data.branchId);
      allow create: if allBranchUserWriteOk(userId)
        || (bootstrapAdmin() && userId == request.auth.uid   // own doc only, must send branchId 'donmueang' (P2-3, U9)
            && userBranch(request.resource.data) == 'donmueang'
            && request.resource.data.keys().hasOnly(userKeys())
            && userRoleOk(request.resource.data))
        // Phase 2 fix 1: branch admins may only create ids shaped like a real Auth UID (28 alphanumerics; 20 = Auto-ID is still flagged in the app).
        // Quotes or other characters in a doc id were stored XSS in the all-branch users screen.
        || (!allBranchAdmin() && userId != allBranchUid() && userId != bootUid()
            && userId.matches('^[A-Za-z0-9]{20,128}$')
            && adminOf(userBranch(request.resource.data))
            && request.resource.data.keys().hasOnly(userKeys())
            && userRoleOk(request.resource.data));
      allow update: if allBranchUserWriteOk(userId)
        || (!allBranchAdmin() && userId != allBranchUid()
            && adminOf(userBranch(resource.data))
            && userBranch(request.resource.data) == userBranch(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
            && userRoleOk(request.resource.data));
      allow delete: if allBranchAdmin()
        || (!allBranchAdmin() && userId != allBranchUid() && userId != bootUid()
            && adminOf(userBranch(resource.data)));
    }

    // ---------- งานประจำวัน — พนักงานทำได้ ----------
    // รับรถ สร้างงาน แก้ไขงาน เปลี่ยนสถานะ ใส่ราคา
    // แต่ "ลบ" สงวนไว้ให้ Admin เท่านั้น
    match /jobs/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    match /vehicles/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    match /customers/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    // รูปภาพหน้างาน — แยกเอกสารละรูป เพื่อไม่ให้เอกสารงานใหญ่เกินลิมิต
    match /jobPhotos/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if hasAccess();
    }

    // บันทึกประวัติการแก้ไข/ลบ — เขียนเพิ่มได้ แต่ห้ามแก้ย้อนหลัง
    match /editLog/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- แคตตาล็อก / ข้อมูลหลัก — Admin เท่านั้น ----------
    // พนักงานอ่านได้ (ต้องใช้ตอนเลือกอะไหล่และดูราคา) แต่แก้ไม่ได้
    /* ---------- 6 ต.ค. 2026 — ทำไมสี่คอลเลกชันข้างล่างต้องให้พนักงานเขียนได้ ----------
       แอปเรียนรู้ราคาเองตลอดเวลา: ทุกครั้งที่ช่างคีย์ราคาลงใบเสนอราคา
       rememberJobPartPrice() เขียนราคานั้นกลับเข้า models/ ทันที (ตั้งแต่ v3.38.0)
       และถ้าชื่ออะไหล่ยังไม่มีในระบบ ก็สร้างลง masterParts/ ให้ด้วย

       กฎเดิมคือ allow write: if isAdmin() แปลว่าเครื่องของพนักงานธรรมดาถูกปฏิเสธ
       ทุกครั้งที่คีย์ราคา — และเพราะแอปรวมทุกอย่างไว้ใน batch เดียว ทั้งแบตช์ล้ม
       คือใบงาน รถ ลูกค้า ที่เพิ่งคีย์ไปพร้อมกันก็ไม่ได้บันทึกไปด้วย

       ให้สิทธิ์แบบเดียวกับ jobs/vehicles/customers: สร้างและแก้ได้ถ้ามีสิทธิ์เข้าระบบ
       ส่วน ลบ ยังเป็นของแอดมินเท่านั้น เพราะลบแคตตาล็อกคือทำลายของที่ใช้ร่วมกัน
       ---------------------------------------------------------------------------- */
    match /models/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    match /masterParts/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    match /partBrandOptions/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    match /complaintTypes/{docId} {
      allow read:   if hasAccess();
      allow create: if hasAccess();
      allow update: if hasAccess();
      allow delete: if isAdmin();
    }

    // ---------- ตั้งค่าร้าน / ธีม / API key ----------
    // [แก้] เดิม write: if isAdmin() ทั้งคอลเลกชัน แต่พนักงานทั่วไปต้องเขียน 3 จุดนี้
    // ทุกวัน: pushTokens (เปิดแจ้งเตือนบนเครื่องตัวเอง), queueCounter (ออกเลขคิว
    // อัตโนมัติตอนรับรถ), และช่อง technicians ที่ฝังอยู่ใน config/main (มอบหมายช่าง
    // จากหน้าจอที่ไม่ได้ล็อกแอดมินไว้) — ที่เหลือ (โลโก้ร้าน, ธีมสี, API key ของ AI ฯลฯ)
    // ยังเป็น Admin เท่านั้นเหมือนเดิม
    //
    // เหตุผลที่ต้องแก้จริงจัง ไม่ใช่แค่ไม่สะดวก: saveState()/flushState() ยิงเป็น
    // batch เดียว ถ้าเอกสารไหนในแบตช์โดนปฏิเสธ ทั้งแบตช์ล้มหมด — พนักงานมอบหมายช่าง
    // จะเห็น toast "มอบหมายแล้ว" ขึ้นก่อน แล้วตามด้วย "ไม่มีสิทธิ์แก้ไขส่วนนี้" และ
    // การมอบหมายงานจริงก็หายไปด้วย ไม่ใช่แค่ config เขียนไม่ผ่านเฉย ๆ
    match /config/{docId} {
      allow read: if hasAccess();
      allow create: if isAdmin()
        || (docId in ['pushTokens','queueCounter'] && hasAccess());
      allow update: if isAdmin()
        || (docId in ['pushTokens','queueCounter'] && hasAccess())
        || (docId == 'main' && hasAccess()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['technicians']));
      allow delete: if isAdmin();
    }

    // ---------- กระดานสถานะสำหรับลูกค้า (เปิดสาธารณะ) ----------
    // หน้านี้ลูกค้าสแกน QR ดูได้โดยไม่ต้องล็อกอิน จึงเป็น "อ่านได้ทุกคน"
    //
    // เหตุผลที่ต้องแยกเป็นคอลเลกชันใหม่ ไม่ใช้ jobs ตรงๆ:
    // กฎของ Firestore เลือกซ่อนเป็นรายช่องไม่ได้ ถ้าเปิดให้อ่าน jobs ได้
    // ก็จะเห็นทั้งเอกสาร รวมถึงชื่อลูกค้า เบอร์โทร อาการ และราคา
    // เอกสารใน board/ จึงเก็บเฉพาะข้อมูลที่เปิดเผยได้ (คิว รุ่นรถ สี ทะเบียนบางส่วน สถานะ)
    // และแอปเป็นคนสร้างให้อัตโนมัติ
    match /board/{docId} {
      allow read:  if true;        // ลูกค้าสแกนดูได้เลย ไม่ต้องล็อกอิน
      allow write: if hasAccess(); // เขียนได้เฉพาะพนักงานที่ล็อกอินแล้ว
    }

    // [bugfix-round2 S2] ราคา/รายละเอียดที่ตัดออกจาก board/ — อ่านผ่าน Cloud Function
    // lookupMyCar (Admin SDK ข้ามกฎ) เท่านั้น · client ห้ามอ่านทุกกรณี (รวมพนักงาน)
    // พนักงานเขียน/ลบได้ (แอพเขียนแยก batch หลัง commit หลัก — ไม่อยู่ใน flushState)
    match /boardPrivate/{docId} {
      allow get, list: if false;
      allow create, update, delete: if hasAccess();
    }

    // [ใหม่] กระจกสำเนาของ board/ ที่ไม่มีอะไรเขียนจริงตอนนี้ (โค้ดแอปคอมเมนต์ไว้ว่า
    // จะให้ Cloud Function trigger คอยอัปเดตแทนในอนาคต เพื่อเปิดเผยข้อมูลน้อยกว่า
    // board/ อีกขั้น) เพิ่มไว้ล่วงหน้าเฉย ๆ เผื่อวันที่ trigger นั้นถูกสร้างขึ้นจริง
    // จะได้ไม่ต้องกลับมาแก้ rules อีกรอบ — เขียนได้เฉพาะฝั่งเซิร์ฟเวอร์ (Admin SDK
    // ของ Cloud Function ข้าม security rules อยู่แล้ว) ฝั่งไคลเอนต์จึงห้ามเขียนเด็ดขาด
    match /boardPublic/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- แชทลูกค้า กับ แอดมิน ----------
    // ลูกค้าล็อกอินแบบ anonymous หลังค้นเจอรถ จึงเป็น signedIn() แต่ไม่มีเอกสารใน
    // users/ ฉะนั้น hasAccess() และ isAdmin() ยังเป็นเท็จ เข้าถึงได้แค่ห้องแชทเท่านั้น
    match /chatThreads/{jobId} {
      // [แก้] เดิม allow read ครอบทั้ง get (อ่านทีละห้อง) และ list (query ทั้งคอลเลกชัน)
      // ลูกค้าคนไหนก็เดา jobId ได้อยู่แล้วจาก board/ ที่เปิดสาธารณะ เท่ากับเปิด
      // ทางให้เปิด console แล้วรัน query แบบเดียวกับที่แอดมินใช้ (orderBy('lastAt')
      // .limit(60)) เห็นห้องแชททุกคันในร้านพร้อมข้อความล่าสุด ไม่ใช่แค่ห้องตัวเอง
      // แยกเป็น get/list: ลูกค้าอ่านห้องตัวเองได้ถ้ารู้ jobId (.doc(id) เท่านั้น)
      // ส่วน list (แอดมินใช้ query จริง) สงวนไว้ให้คนที่มีสิทธิ์เท่านั้น
      allow get: if anonCustomer() || hasAccess();
      allow list: if isAdmin();
      /* [แก้ 24 ต.ค. 2569 — bugfix-sweep S-NEW-1]
         เดิม create/update ห้อง = signedIn() เฉย ๆ และข้อความไม่ตรวจช่อง from เลย
         ลูกค้า anonymous จึงปลอมข้อความเป็น from:'admin' / 'bot' ("โอนเงินมาบัญชีนี้")
         และเขียนคีย์อะไรก็ได้ลงเอกสารห้อง
         ตอนนี้:
           - พนักงาน (hasAccess) เขียนห้องได้เหมือนเดิม
           - ลูกค้าเขียนได้เฉพาะคีย์ที่หน้าลูกค้าเขียนจริง (chatSend / chatMarkRead /
             chatRequestHuman ใน index.html) ดู chatThreadCustomerKeys() ข้างล่าง
             และ lastFrom ที่ลูกค้าเปลี่ยนต้องเป็น 'customer'
           - (รอบ 1 หลังตรวจ security) ลูกค้าแก้ lastText ได้ต่อเมื่อ lastFrom หลังเขียน = 'customer'
             (กันแก้ lastText เฉย ๆ บนห้องที่แอดมินตอบล่าสุด แล้วรายการแอดมินขึ้น "ทางอู่: <ข้อความปลอม>")
           - jobId ต้องเท่ากับ id ของห้องเสมอ (ล็อกเฉพาะ jobId ตามคำตัดสิน PM · plate / queueNo /
             carName / province ยังเขียนได้ เพราะพนักงานแก้ใบงานหลังเปิดห้องแล้ว chatSend พกค่าใหม่มา)
           - unreadAdmin ต้องเป็น int (increment(1) ของ chatSend / chatRequestHuman)
           - unreadCustomer ที่ลูกค้าเขียนได้มีค่าเดียวคือ 0 (chatMarkRead / chatSend)
           - ข้อความ: from ต้องเป็น string · ไม่ใช่พนักงาน = 'customer' เท่านั้น
             พนักงานเขียน 'admin' ได้ · 'bot' เขียนจากเบราว์เซอร์ไม่ได้ (Bot ใช้ Admin SDK)
         แก้ฟิลด์ที่หน้าลูกค้าเขียน ต้องแก้รายการคีย์ตรงนี้ด้วย ไม่งั้นแชทลูกค้าพัง */
      allow create: if hasAccess()
        || (anonCustomer()
            && request.resource.data.keys().hasOnly(chatThreadCustomerKeys())
            && request.resource.data.get('lastFrom', 'customer') == 'customer'
            && (!('lastText' in request.resource.data)
                || request.resource.data.get('lastFrom', '') == 'customer')
            && request.resource.data.get('jobId', jobId) == jobId
            && request.resource.data.get('unreadAdmin', 0) is int
            && request.resource.data.get('unreadCustomer', 0) is int
            && request.resource.data.get('unreadCustomer', 0) == 0);
      allow update: if hasAccess()
        || (anonCustomer()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(chatThreadCustomerKeys())
            && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.lastFrom == 'customer')
            && (!('lastText' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('lastFrom', '') == 'customer')
            && (!('jobId' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.jobId == jobId)
            && request.resource.data.get('unreadAdmin', 0) is int
            && (!('unreadCustomer' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.unreadCustomer is int
                    && request.resource.data.unreadCustomer == 0)));
      allow delete: if false;
      match /messages/{msgId} {
        allow read: if anonCustomer() || hasAccess();
        allow create: if (anonCustomer() || hasAccess())
          && request.resource.data.keys().hasOnly(['text','from','at','name'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.from is string
          && (request.resource.data.from == 'customer'
              || (request.resource.data.from == 'admin' && hasAccess()));
        allow update, delete: if false;
      }
    }

    // ---------- คะแนนจากลูกค้า (หน้า ?feedback) ----------
    // [ใหม่] ไม่มี rule ให้คอลเลกชันนี้มาก่อนเลย ถูก catch-all ท้ายไฟล์ปฏิเสธหมด
    // ลูกค้าให้ดาวไม่ได้ แอดมินก็ดูคะแนนไม่ได้ ทั้งที่โค้ดแอปสร้างไว้ครบแล้ว
    // ลูกค้า anonymous สร้างได้ครั้งเดียวต่อ jobId (เอกสารใช้ jobId เป็น doc id เอง
    // ในโค้ดแอป — สร้างซ้ำเท่ากับเขียนทับ ไม่ใช่เพิ่มแถวใหม่ จึงไม่ต้องกันสแปมเพิ่ม)
    // แก้ไม่ได้แม้แต่แอดมิน ให้เป็นคะแนนดิบที่ลูกค้าให้จริง ณ ตอนนั้น
    match /feedback/{jobId} {
      allow read: if hasAccess();
      allow create: if (anonCustomer() || hasAccess())
        && request.resource.data.keys().hasOnly(['stars','comment','queueNo','plate','at'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500;
      allow update, delete: if false;
    }

    // ---------- ใครใช้แอปอยู่ตอนนี้ (v4.0.0) ----------
    // [ใหม่] heartbeat ทุก 45 วิ เขียนตรงจาก presenceStripHtml()/startPresenceHeartbeat()
    // ในโค้ดแอป — เขียนได้เฉพาะเอกสารของ uid ตัวเอง (คนอื่นปลอมสถานะคนอื่นไม่ได้)
    // อ่านได้เฉพาะคนที่มีสิทธิ์ในระบบ (ไม่ใช่ข้อมูลสาธารณะเหมือน board/)
    match /presence/{uid} {
      allow read: if hasAccess();
      allow write: if hasAccess() && request.auth.uid == uid;
    }

    // ---------- กลุ่ม LINE ที่ Bot ตอบได้ (line-bot-queue-command) ----------
    // [ใหม่] Cloud Function (Admin SDK ข้าม rules) เป็นคนเดียวที่สร้างเอกสารตอน Bot
    // ถูกเชิญเข้ากลุ่ม (status: pending) · client สร้างเองไม่ได้แม้เป็นแอดมิน
    // แอดมินอ่าน/แก้ได้เฉพาะ 4 คีย์ ผ่าน .doc(id).update() ในหน้า "ตั้งค่า → กลุ่ม LINE"
    // approvedBy ต้องเป็น uid ของคนกดเอง (หลักฐานการอนุมัติต้องเชื่อได้)
    // approvedAt เป็น ISO string จาก nowIso() เหมือนทั้งแอป (BR-4)
    // ห้ามใส่ lineGroups ใน SYNC_COLLECTIONS — เครื่องพนักงานจะทำ batch ล้มทั้งก้อน
    // lineBotState/ (กันซ้ำของ Bot) ไม่มีกฎ = catch-all ข้างล่างปิดให้ client ทั้งหมด
    match /lineGroups/{groupId} {
      allow read: if isAdmin();
      allow create: if false;
      // เปลี่ยนเป็นอนุมัติ (จากสถานะอื่น) ต้องลงชื่อคนกดเอง (approvedBy = uid) + approvedAt ใหม่ทุกครั้ง
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedBy', 'approvedAt', 'label'])
        && request.resource.data.status in ['approved', 'revoked', 'pending']
        && (resource.data.status == 'approved'
            || request.resource.data.status != 'approved'
            || (request.resource.data.approvedBy == request.auth.uid
                && 'approvedAt' in request.resource.data.diff(resource.data).affectedKeys()))
        && (!('approvedBy' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.approvedBy == request.auth.uid)
        && (!('approvedAt' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.approvedAt is string
                && request.resource.data.approvedAt.size() <= 40
                && request.resource.data.approvedAt.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$')))
        && (!('label' in request.resource.data)
            || (request.resource.data.label is string
                && request.resource.data.label.size() <= 60));
      // ลบไม่ได้จากแอป (กลุ่มที่ไม่ต้องการ = ไม่รับ / ยกเลิกสิทธิ์) · ถ้าลบได้ การเชิญ Bot ซ้ำจะได้ pending ใหม่
      allow delete: if false;
    }

    // ---------- สต็อกอะไหล่ (parts-stock) ----------
    // ไม่อยู่ใน SYNC_COLLECTIONS/flushState — แอพเขียนด้วย runTransaction ของตัวเองเท่านั้น
    // หลัก (S1): qty ของ stockItems เปลี่ยนได้ "คู่กับ" stockMoves ใหม่ 1 ใบในคำขอเดียวกันเท่านั้น
    //   item.lastMoveId ชี้ move ที่ "ยังไม่มีก่อนคำขอนี้" และ qty ใหม่ = qty เดิม + delta ของ move นั้น
    //   ใช้กับทุกคนรวมแอดมิน — แอดมินเปลี่ยนยอดได้ทางเดียวคือ move 'adjust' พร้อมเหตุผล
    function stockItemPath(iid) { return /databases/$(database)/documents/stockItems/$(iid); }
    function stockMovePath(mid) { return /databases/$(database)/documents/stockMoves/$(mid); }
    function strMax(v, n) { return v is string && v.size() <= n; }

    function stockItemKeys() {
      return ['masterPartId','name','nameKey','brand','brandKey','fits','fitsKey',
              'category','unit','qty','minQty','location','active','lastMoveId',
              'createdAt','createdBy','createdByUid','updatedAt','updatedBy','updatedByUid'];
    }
    function stockMoveKeys() {
      return ['itemId','type','delta','qtyBefore','qtyAfter','jobId','rowId','seq','jobNumber',
              'partName','supplier','billNo','reason','token','at','serverAt','by','byUid'];
    }

    // ช่องข้อความทุกช่องของรายการ (ทั้ง create และ update ทุกทาง)
    function stockItemTextOk(d) {
      return strMax(d.name, 120) && strMax(d.get('nameKey', ''), 120)
        && strMax(d.get('brand', ''), 40) && strMax(d.brandKey, 60)
        && strMax(d.get('fits', ''), 80) && strMax(d.fitsKey, 60)
        && strMax(d.get('category', ''), 40) && strMax(d.get('unit', ''), 20)
        && strMax(d.get('location', ''), 40)
        && strMax(d.get('updatedAt', ''), 40) && strMax(d.get('updatedBy', ''), 80);
    }

    // S1 — qty ที่เปลี่ยน ต้องมาพร้อม move ใหม่ที่เพิ่งเกิดในคำขอนี้ ของคนที่ล็อกอินอยู่เอง
    function qtyByNewMove(itemId, oldQty) {
      let mid = request.resource.data.lastMoveId;
      let mv  = getAfter(stockMovePath(mid)).data;
      return mid is string
        && !exists(stockMovePath(mid))
        && mv.itemId == itemId
        && mv.byUid == request.auth.uid
        && mv.delta == request.resource.data.qty - oldQty
        && mv.qtyAfter == request.resource.data.qty;
    }

    match /stockItems/{itemId} {
      allow get, list: if hasAccess();

      allow create: if hasAccess()
        && request.resource.data.keys().hasOnly(stockItemKeys())
        && itemId == request.resource.data.masterPartId + '|'
                     + request.resource.data.brandKey + '|' + request.resource.data.fitsKey
        && request.resource.data.qty is int
        && request.resource.data.minQty is int && request.resource.data.minQty >= 0
        && request.resource.data.active is bool
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && strMax(request.resource.data.get('createdBy', ''), 80)
        && stockItemTextOk(request.resource.data)
        && exists(/databases/$(database)/documents/masterParts/$(request.resource.data.masterPartId))
        && (
             // S2 พนักงาน (และแอดมิน) — สร้างตอนรับของเข้าครั้งแรก: คู่ move 'receive' เท่านั้น
             (request.resource.data.active == true
              && request.resource.data.minQty == 0
              && qtyByNewMove(itemId, 0)
              && getAfter(stockMovePath(request.resource.data.lastMoveId)).data.type == 'receive')
             // แอดมินสร้างรายการเปล่าล่วงหน้า — qty 0 ไม่มี move (ไม่ใช่การเปลี่ยนยอด)
          || (isAdmin()
              && request.resource.data.qty == 0
              && !('lastMoveId' in request.resource.data))
        );

      allow update: if hasAccess()
        && request.resource.data.keys().hasOnly(stockItemKeys())
        && request.resource.data.updatedByUid == request.auth.uid
        && stockItemTextOk(request.resource.data)
        && (
             // ก. เปลี่ยนยอด (ทุกคน รวมแอดมิน) — แตะได้แค่ qty + lastMoveId + updated*
             (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['qty','lastMoveId','updatedAt','updatedBy','updatedByUid'])
              && request.resource.data.qty is int
              && qtyByNewMove(itemId, resource.data.qty)
              // รายการที่ปิดแล้ว: รับ/เบิกไม่ได้ คืนได้ · แอดมิน adjust ได้
              && (resource.data.active == true
                  || getAfter(stockMovePath(request.resource.data.lastMoveId)).data.type in ['return','adjust']))
             // ข. ตั้งค่ารายการ (แอดมินเท่านั้น) — ห้ามแตะ qty/lastMoveId/ตัวตน/ผู้สร้าง (S3)
          || (isAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['qty','lastMoveId','masterPartId','brandKey','fitsKey',
                            'createdAt','createdBy','createdByUid'])
              && request.resource.data.minQty is int && request.resource.data.minQty >= 0
              && request.resource.data.active is bool)
        );

      allow delete: if false;   // ปิดรายการ = active:false
    }

    // move ของใบงาน: id = 'j_' + jobId + '|' + rowId + '|' + seq · seq ต่อกันห้ามข้าม · ใบงานต้องมีจริง
    function stockJobMoveOk(moveId) {
      let d = request.resource.data;
      return d.jobId is string && d.jobId.matches('^[A-Za-z0-9_-]{1,40}$')
        && d.rowId is string && d.rowId.matches('^[A-Za-z0-9_-]{1,40}$')
        && d.seq is int && d.seq >= 1
        && moveId == 'j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq)
        && (d.seq == 1
            || exists(stockMovePath('j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq - 1))))
        && exists(/databases/$(database)/documents/jobs/$(d.jobId));
    }

    // คืน: ต้องต่อจาก move ก่อนหน้า (seq-1) ของบรรทัดเดียวกัน ที่เป็น issue/return ของ itemId เดียวกัน
    //   ไล่ย้อนตามสายจะเจอ issue ของรายการนี้เสมอ (seq 1 คืนไม่ได้) · ไม่ผูก |1 ตายตัว:
    //   บรรทัดที่คืนครบแล้วเบิกรายการอื่นต่อได้ (แอพ: stockReturn คืนเข้า itemId ของ move ล่าสุดของบรรทัด)
    //   ยอดคืน ≤ ยอดเบิกค้าง ตรวจในแอพ (stockRowOut) — กฎรวมผลทั้งสายไม่ได้ในงบ get()
    function stockReturnBoundOk() {
      let d = request.resource.data;
      let prev = get(stockMovePath('j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq - 1))).data;
      return d.seq >= 2
        && prev.type in ['issue','return']
        && prev.itemId == d.itemId;
    }

    // ช่องข้อความทุกช่องของ move — ใช้กับทุก type
    function stockMoveTextOk(d) {
      return strMax(d.by, 80) && strMax(d.at, 40)
        && strMax(d.get('token', ''), 24)
        && strMax(d.get('jobNumber', ''), 40) && strMax(d.get('partName', ''), 120)
        && strMax(d.get('supplier', ''), 80) && strMax(d.get('billNo', ''), 40)
        && strMax(d.get('reason', ''), 200);
    }

    match /stockMoves/{moveId} {
      allow get, list: if hasAccess();

      allow create: if hasAccess()
        && request.resource.data.keys().hasOnly(stockMoveKeys())
        && request.resource.data.byUid == request.auth.uid            // S4
        && stockMoveTextOk(request.resource.data)
        && request.resource.data.serverAt == request.time             // S5
        && request.resource.data.itemId is string
        && request.resource.data.delta is int
        && request.resource.data.delta != 0
        && request.resource.data.delta >= -9999 && request.resource.data.delta <= 9999
        && request.resource.data.qtyAfter is int
        && request.resource.data.qtyBefore is int
        && request.resource.data.qtyBefore + request.resource.data.delta == request.resource.data.qtyAfter
        // move ต้องมาพร้อมการเปลี่ยน qty ของรายการที่อ้าง (move ลอย ๆ ไม่ได้)
        && getAfter(stockItemPath(request.resource.data.itemId)).data.lastMoveId == moveId
        && getAfter(stockItemPath(request.resource.data.itemId)).data.qty == request.resource.data.qtyAfter
        && (
             (request.resource.data.type == 'receive'
              && request.resource.data.delta > 0
              && moveId.matches('^r_[A-Za-z0-9]{6,24}$'))
          || (request.resource.data.type == 'issue'
              && request.resource.data.delta < 0
              && stockJobMoveOk(moveId))
          || (request.resource.data.type == 'return'
              && request.resource.data.delta > 0
              && stockJobMoveOk(moveId)
              && stockReturnBoundOk())
          || (request.resource.data.type == 'adjust'
              && isAdmin()
              && moveId.matches('^a_[A-Za-z0-9]{6,24}$')
              && request.resource.data.reason is string
              && request.resource.data.reason.size() <= 200
              && request.resource.data.reason.matches('.*[^ ].*'))
        );

      allow update, delete: if false;   // ประวัติแก้/ลบไม่ได้ แม้แอดมิน
    }

    // ---------- new branches (multi-branch) ----------
    // Don Mueang stays at root; validBranch() rejects branches/donmueang for everyone (B-4).
    // No {document=**} grant. No bootstrap (B-7).
    // Phase 3: public paths open per branch (S-1 lifted). Customers reach chat/feedback only with a grant
    // written by lookupMyCar (Admin SDK) at branches/{b}/chatGrants/{uid}_{jobId} (chat) or {uid}_{jobId}_fb (feedback) (B-8 for new branches).
    // No rule matches chatGrants: every client read/write of it falls to the catch-all (denied).
    match /branches/{branchId} {
      function bAccess() { return validBranch(branchId) && memberOf(branchId); }
      function bAdmin()  { return validBranch(branchId) && adminOf(branchId); }
      function bStockItemPath(iid) { return /databases/$(database)/documents/branches/$(branchId)/stockItems/$(iid); }
      function bStockMovePath(mid) { return /databases/$(database)/documents/branches/$(branchId)/stockMoves/$(mid); }
      // Phase 2 fix 2: doc ids created under a branch. The all-branch account renders branch ids raw inside
      // onclick="...('<id>')" (~147 handlers), so an id with ' " < > &  or whitespace was stored XSS.
      // Allowed = what the app really writes: uid() [a-z0-9]{<=11}, Auto-ID [A-Za-z0-9]{20}, Auth UID [A-Za-z0-9]{28},
      // dc0..dc7, config main/pushTokens/queueCounter/boardMode; _ and - are harmless margin (same set as stock jobId/rowId).
      // Creates only: a doc that already exists keeps its id (updates/deletes unchanged).
      // Not used on stockItems/stockMoves: move ids are already pinned (r_/a_/j_ regex), item ids = masterPartId|brandKey|fitsKey
      // (brandKey may be Thai) and the stock screens pass ids through data-* + escapeAttr; both must stay equal to root (guard B8).
      function bIdOk(id) { return id.matches('^[A-Za-z0-9_-]{1,128}$'); }

      // Phase 3: grant check for anonymous customers. 1 distinct doc read (repeated get of one doc counts once).
      // A grant of branch A lives under branches/A, so it can never satisfy a rule under branches/B.
      // S-1 (fix loop 1): two grant ids. {uid}_{jobId} = purpose 'reception' (cars still in the shop) -> chat + feedback.
      // {uid}_{jobId}_fb = purpose 'feedback' (may be a car delivered up to 14 days ago) -> feedback only, never chat.
      // A feedback lookup writes only the _fb id, so it cannot overwrite (or downgrade) a chat grant.
      function bGrantPath(gid) { return /databases/$(database)/documents/branches/$(branchId)/chatGrants/$(gid); }
      function bGranted(jobId) {
        return validBranch(branchId) && anonCustomer()
          && exists(bGrantPath(request.auth.uid + '_' + jobId))
          && get(bGrantPath(request.auth.uid + '_' + jobId)).data.uid == request.auth.uid
          && get(bGrantPath(request.auth.uid + '_' + jobId)).data.jobId == jobId
          && get(bGrantPath(request.auth.uid + '_' + jobId)).data.purpose == 'reception'
          && get(bGrantPath(request.auth.uid + '_' + jobId)).data.expireAt is timestamp
          && get(bGrantPath(request.auth.uid + '_' + jobId)).data.expireAt > request.time;
      }
      // feedback grant: 1 distinct doc read (the _fb id). Used by feedback create only.
      function bFbGranted(jobId) {
        return validBranch(branchId) && anonCustomer()
          && exists(bGrantPath(request.auth.uid + '_' + jobId + '_fb'))
          && get(bGrantPath(request.auth.uid + '_' + jobId + '_fb')).data.uid == request.auth.uid
          && get(bGrantPath(request.auth.uid + '_' + jobId + '_fb')).data.jobId == jobId
          && get(bGrantPath(request.auth.uid + '_' + jobId + '_fb')).data.purpose == 'feedback'
          && get(bGrantPath(request.auth.uid + '_' + jobId + '_fb')).data.expireAt is timestamp
          && get(bGrantPath(request.auth.uid + '_' + jobId + '_fb')).data.expireAt > request.time;
      }
      // customer = anonymous + grant · everyone else = branch member. Anonymous never falls through to bAccess (no users read).
      function bCustomerOr(jobId) {
        return (anonCustomer() && bGranted(jobId)) || (!anonCustomer() && bAccess());
      }

      // Phase 3: get is public so the customer page can show the branch name and refuse an unknown/unopened branch
      // (fields: name, code, address, phone, createdAt, catalogCopy*; all business info). list stays all-branch only.
      allow get:  if validBranch(branchId);
      allow list: if allBranchAdmin();
      // U-5: job-number code is 2 capital letters and never PG · a name is required · fixed key list
      allow create, update: if allBranchAdmin() && validBranch(branchId)
        && request.resource.data.keys().hasOnly(['name', 'code', 'address', 'phone', 'createdAt', 'catalogCopyStartedAt', 'catalogCopiedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z]{2}$')
        && request.resource.data.code != 'PG';
      allow delete: if false;

      match /jobs/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /vehicles/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /customers/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /models/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /masterParts/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /partBrandOptions/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }

      match /complaintTypes/{docId} {
        allow read:   if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if bAccess();
        allow delete: if bAdmin();
      }
      match /jobPhotos/{docId} {
        allow read, update, delete: if bAccess();
        allow create: if bAccess() && bIdOk(docId);
      }
      match /editLog/{docId} {
        allow read: if bAccess();
        allow create: if bAccess() && bIdOk(docId);
        allow update: if false;
        allow delete: if bAdmin();
      }
      match /config/{docId} {
        allow read: if bAccess();
        allow create: if (bAdmin()
          || (docId in ['pushTokens','queueCounter'] && bAccess()))
          && bIdOk(docId);
        allow update: if bAdmin()
          || (docId in ['pushTokens','queueCounter'] && bAccess())
          || (docId == 'main' && bAccess()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['technicians']));
        allow delete: if bAdmin();
      }
      // Phase 3: public read, same as root board (S-1 lifted). The write rule keeps the doc to queue + status only
      // (decision 6, S-2): must equal BOARD_BRANCH_KEYS in index.html. delete is separate: request.resource does not exist on delete (S-3)
      match /board/{docId} {
        allow read: if validBranch(branchId);
        allow create, update: if bAccess()
          && request.resource.data.keys().hasOnly(['queueNo','queueLabel','status','statusLabel','statusCls','estMins','workStart','workEnd','bay','bayAt','createdAt','updatedAt'])
          && (request.method != 'create' || bIdOk(docId));
        allow delete: if bAccess();
      }
      match /boardPrivate/{docId} {
        allow get, list: if false;
        allow update, delete: if bAccess();
        allow create: if bAccess() && bIdOk(docId);
      }
      match /presence/{uid} {
        allow read: if bAccess();
        allow write: if bAccess() && request.auth.uid == uid
          && (request.method != 'create' || bIdOk(uid));
      }
      // Phase 3: customer = anonymous with a grant for this job (B-8). One slot per job: create only, never update.
      // S-1: either grant works here (chat grant via bCustomerOr, or the _fb feedback grant).
      match /feedback/{jobId} {
        allow read: if bAccess();
        allow create: if (bCustomerOr(jobId) || bFbGranted(jobId)) && bIdOk(jobId)
          && request.resource.data.keys().hasOnly(['stars','comment','queueNo','plate','at'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500;
        allow update, delete: if false;
      }
      // Phase 3: customer clauses copied from root chatThreads (S-NEW-1) + grant. Staff paths unchanged.
      match /chatThreads/{jobId} {
        allow get: if bCustomerOr(jobId);
        allow list: if bAdmin();
        allow create: if bIdOk(jobId) && (
          (!anonCustomer() && bAccess())
          || (anonCustomer() && bGranted(jobId)
              && request.resource.data.keys().hasOnly(chatThreadCustomerKeys())
              && request.resource.data.get('lastFrom', 'customer') == 'customer'
              && (!('lastText' in request.resource.data)
                  || request.resource.data.get('lastFrom', '') == 'customer')
              && request.resource.data.get('jobId', jobId) == jobId
              && request.resource.data.get('unreadAdmin', 0) is int
              && request.resource.data.get('unreadCustomer', 0) is int
              && request.resource.data.get('unreadCustomer', 0) == 0));
        allow update: if (!anonCustomer() && bAccess())
          || (anonCustomer() && bGranted(jobId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(chatThreadCustomerKeys())
              && (!('lastFrom' in request.resource.data.diff(resource.data).affectedKeys())
                  || request.resource.data.lastFrom == 'customer')
              && (!('lastText' in request.resource.data.diff(resource.data).affectedKeys())
                  || request.resource.data.get('lastFrom', '') == 'customer')
              && (!('jobId' in request.resource.data.diff(resource.data).affectedKeys())
                  || request.resource.data.jobId == jobId)
              && request.resource.data.get('unreadAdmin', 0) is int
              && (!('unreadCustomer' in request.resource.data.diff(resource.data).affectedKeys())
                  || (request.resource.data.unreadCustomer is int
                      && request.resource.data.unreadCustomer == 0)));
        allow delete: if false;
        match /messages/{msgId} {
          allow read: if bCustomerOr(jobId);
          allow create: if bIdOk(msgId)
            && ((!anonCustomer() && bAccess())
                || (anonCustomer() && bGranted(jobId) && request.resource.data.from == 'customer'))
            && request.resource.data.keys().hasOnly(['text','from','at','name'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.from in ['customer', 'admin'];
          allow update, delete: if false;
        }
      }

      // stock: root rules copied verbatim, only b* names and jobs/masterParts paths differ (a guard compares both)
      function bQtyByNewMove(itemId, oldQty) {
        let mid = request.resource.data.lastMoveId;
        let mv  = getAfter(bStockMovePath(mid)).data;
        return mid is string
          && !exists(bStockMovePath(mid))
          && mv.itemId == itemId
          && mv.byUid == request.auth.uid
          && mv.delta == request.resource.data.qty - oldQty
          && mv.qtyAfter == request.resource.data.qty;
      }

      match /stockItems/{itemId} {
        allow get, list: if bAccess();

        allow create: if bAccess()
          && request.resource.data.keys().hasOnly(stockItemKeys())
          && itemId == request.resource.data.masterPartId + '|'
                       + request.resource.data.brandKey + '|' + request.resource.data.fitsKey
          && request.resource.data.qty is int
          && request.resource.data.minQty is int && request.resource.data.minQty >= 0
          && request.resource.data.active is bool
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.updatedByUid == request.auth.uid
          && strMax(request.resource.data.get('createdBy', ''), 80)
          && stockItemTextOk(request.resource.data)
          && exists(/databases/$(database)/documents/branches/$(branchId)/masterParts/$(request.resource.data.masterPartId))
          && (
               (request.resource.data.active == true
                && request.resource.data.minQty == 0
                && bQtyByNewMove(itemId, 0)
                && getAfter(bStockMovePath(request.resource.data.lastMoveId)).data.type == 'receive')
            || (bAdmin()
                && request.resource.data.qty == 0
                && !('lastMoveId' in request.resource.data))
          );

        allow update: if bAccess()
          && request.resource.data.keys().hasOnly(stockItemKeys())
          && request.resource.data.updatedByUid == request.auth.uid
          && stockItemTextOk(request.resource.data)
          && (
               (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['qty','lastMoveId','updatedAt','updatedBy','updatedByUid'])
                && request.resource.data.qty is int
                && bQtyByNewMove(itemId, resource.data.qty)
                && (resource.data.active == true
                    || getAfter(bStockMovePath(request.resource.data.lastMoveId)).data.type in ['return','adjust']))
            || (bAdmin()
                && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['qty','lastMoveId','masterPartId','brandKey','fitsKey',
                              'createdAt','createdBy','createdByUid'])
                && request.resource.data.minQty is int && request.resource.data.minQty >= 0
                && request.resource.data.active is bool)
          );

        allow delete: if false;   // ปิดรายการ = active:false
      }

      function bStockJobMoveOk(moveId) {
        let d = request.resource.data;
        return d.jobId is string && d.jobId.matches('^[A-Za-z0-9_-]{1,40}$')
          && d.rowId is string && d.rowId.matches('^[A-Za-z0-9_-]{1,40}$')
          && d.seq is int && d.seq >= 1
          && moveId == 'j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq)
          && (d.seq == 1
              || exists(bStockMovePath('j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq - 1))))
          && exists(/databases/$(database)/documents/branches/$(branchId)/jobs/$(d.jobId));
      }

      function bStockReturnBoundOk() {
        let d = request.resource.data;
        let prev = get(bStockMovePath('j_' + d.jobId + '|' + d.rowId + '|' + string(d.seq - 1))).data;
        return d.seq >= 2
          && prev.type in ['issue','return']
          && prev.itemId == d.itemId;
      }

      function stockMoveTextOk(d) {
        return strMax(d.by, 80) && strMax(d.at, 40)
          && strMax(d.get('token', ''), 24)
          && strMax(d.get('jobNumber', ''), 40) && strMax(d.get('partName', ''), 120)
          && strMax(d.get('supplier', ''), 80) && strMax(d.get('billNo', ''), 40)
          && strMax(d.get('reason', ''), 200);
      }

      match /stockMoves/{moveId} {
        allow get, list: if bAccess();

        allow create: if bAccess()
          && request.resource.data.keys().hasOnly(stockMoveKeys())
          && request.resource.data.byUid == request.auth.uid            // S4
          && stockMoveTextOk(request.resource.data)
          && request.resource.data.serverAt == request.time             // S5
          && request.resource.data.itemId is string
          && request.resource.data.delta is int
          && request.resource.data.delta != 0
          && request.resource.data.delta >= -9999 && request.resource.data.delta <= 9999
          && request.resource.data.qtyAfter is int
          && request.resource.data.qtyBefore is int
          && request.resource.data.qtyBefore + request.resource.data.delta == request.resource.data.qtyAfter
          && getAfter(bStockItemPath(request.resource.data.itemId)).data.lastMoveId == moveId
          && getAfter(bStockItemPath(request.resource.data.itemId)).data.qty == request.resource.data.qtyAfter
          && (
               (request.resource.data.type == 'receive'
                && request.resource.data.delta > 0
                && moveId.matches('^r_[A-Za-z0-9]{6,24}$'))
            || (request.resource.data.type == 'issue'
                && request.resource.data.delta < 0
                && bStockJobMoveOk(moveId))
            || (request.resource.data.type == 'return'
                && request.resource.data.delta > 0
                && bStockJobMoveOk(moveId)
                && bStockReturnBoundOk())
            || (request.resource.data.type == 'adjust'
                && bAdmin()
                && moveId.matches('^a_[A-Za-z0-9]{6,24}$')
                && request.resource.data.reason is string
                && request.resource.data.reason.size() <= 200
                && request.resource.data.reason.matches('.*[^ ].*'))
          );

        allow update, delete: if false;   // ประวัติแก้/ลบไม่ได้ แม้แอดมิน
      }
    }

    // ---------- ปิดทุกอย่างที่ไม่ได้ระบุไว้ข้างบน ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
